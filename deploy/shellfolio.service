[Unit]
Description=Shellfolio: mosambiswas.com for terminals (ssh on 22, curl on 80 and 443)
After=network-online.target
Wants=network-online.target

[Service]
User=shellfolio
Group=shellfolio
# The host key (.ssh/id_ed25519) and Let's Encrypt certificates (certs/) live here.
WorkingDirectory=/var/lib/shellfolio
ExecStart=/usr/local/bin/shellfolio -ssh :22 -http :80 -https :443 -domain mosambiswas.com
Restart=always
RestartSec=2

# Low ports without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# It only ever needs to write its own folder.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/shellfolio

[Install]
WantedBy=multi-user.target
